{
  "name": "quizz",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply quizz-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply quizz-db --remote",
    "typecheck": "tsc -b"
  },
  "type": "module",
  "dependencies": {
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.343",
    "hono": "^4.13.11",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jose": "^6.2.12",
    "nanoid": "^6.0.1",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.144.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true
  },
  "private": true
}
